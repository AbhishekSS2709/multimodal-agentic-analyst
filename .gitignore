# Runtime artifact created by the LangGraph checkpointer
data/graph_checkpoints.db
data/graph_checkpoints.db-shm
data/graph_checkpoints.db-wal

# Local secrets — never commit. Copy .env.example to .env and fill it in.
# The glob matters: files like "gemini key.env" and "langchain.env" were sitting
# untracked and un-ignored, one `git add -A` away from being published.
*.env
.env
.env.bak
.env.local
!.env.example

# Python bytecode. 49 .pyc files were tracked, so every run showed up as a diff.
__pycache__/
*.py[cod]

# Build artifacts, rebuilt by `orchestrator.setup()` — 4.6 MB of FAISS index
# and 62 MB of generated charts have no business in the history.
vector_store/
static/charts/
