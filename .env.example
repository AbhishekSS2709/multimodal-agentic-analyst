# LLM Provider Configuration
# Options: "ollama", "huggingface", "groq", "openai", "auto"
# Default: "huggingface" (FREE, runs locally, no API key needed)
LLM_PROVIDER=huggingface

# --- FREE Options ---

# Option 1: HuggingFace (default) - runs locally, no key needed
# Just works out of the box with google/flan-t5-base

# Option 2: Ollama - install from ollama.com, then: ollama pull mistral
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=mistral

# Option 3: Groq - free tier at console.groq.com (14,400 req/day)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here

# --- PAID Option ---
# Option 4: OpenAI (paid)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# --- LangGraph agentic layer (both optional) ---
# Gemini: free tier at aistudio.google.com. Without it the graph runs in
# heuristic mode -- every node has a deterministic fallback.
# GEMINI_API_KEY=

# LangSmith: free tier at smith.langchain.com. Without it tracing is off.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multimodal-agentic-analyst

# --- Self-hosted / OpenAI-compatible servers (all optional) ---
# Point the graph at any server speaking the OpenAI API -- llama.cpp, vLLM,
# Ollama's /v1, LM Studio.  Preferred over Gemini and Groq when set, because
# it has no per-day budget: a 25-example evaluation costs ~200 LLM calls, and
# both free tiers exhaust before it finishes.  The server names its own
# models, so GRAPH_LLM_MODEL is required alongside the URL.
# GRAPH_LLM_BASE_URL=http://localhost:8001/v1
# GRAPH_LLM_MODEL=google/gemma-4-E4B-it
# GRAPH_LLM_API_KEY=            # only if your server requires one
# GRAPH_LLM_RPM=20              # pace calls against a rate-limited tier

# Reasoning models put their chain of thought in `content`, which then lands
# in the answer and is scored as if it were the answer.  This is a JSON
# pass-through to the client's extra_body, because every server spells it
# differently.  vLLM + Qwen3.5:
# GRAPH_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Embed on a server instead of loading sentence-transformers locally.  Unlike
# the LLM, this cannot fall back to a heuristic -- something has to turn text
# into vectors -- so on a small machine it is the one unavoidable local cost.
# EMBEDDING_BASE_URL=http://localhost:8002/v1
# EMBEDDING_MAX_CHARS=1200      # bge accepts 512 tokens; dense text runs ~2.5 chars/token

# The v1 pipeline's own provider (used by SQLAgent), same idea:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=google/gemma-4-E4B-it
